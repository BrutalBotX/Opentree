<RCC>
    <qresource prefix="/icons">
        <file alias="appicon.ico">../appicon.ico</file>
        <file alias="arrow_up.png">icons/arrow_up.png</file>
        <file alias="arrow_down.png">icons/arrow_down.png</file>
        <file alias="check.png">icons/check.png</file>
    </qresource>
    <qresource prefix="/sql">
        <file alias="schema.sql">sql/schema.sql</file>
    </qresource>
    <qresource prefix="/js">
        <file>vis-network.min.js</file>
    </qresource>
</RCC>
